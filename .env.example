DATABASE_URL=postgresql://modular:modular@localhost:5432/modular_crm
BETTER_AUTH_URL=http://localhost:3000
# Local development only. Before pnpm build, replace with a unique 32+ character secret.
# Generate one with: openssl rand -hex 32 (keep it in your local environment, never Git).
BETTER_AUTH_SECRET=dev-only-replace-before-deploying-0123456789
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
MOCK_CONNECTORS=true
# Lets local development simulate custom-domain DNS verification. Never enable this in production.
DOMAIN_VERIFICATION_MODE=mock
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=modular-crm
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=modular
OBJECT_STORAGE_SECRET_KEY=modular-dev-only
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Worker health listener: GET /api/health/live and /api/health/ready (web uses the app port).
WORKER_HEALTH_PORT=3001
# Development-only key for encrypted outbound webhook signing secrets. Replace before deployment.
WEBHOOK_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Dedicated development-only 32-byte base64url key for tenant connector credentials and OAuth PKCE data.
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET=
MICROSOFT_365_TENANT=common

# Production startup (web and worker) validates all settings together, never printing values.
# DATABASE_URL and BETTER_AUTH_URL / APP_BASE_URL / PUBLIC_BASE_URL are required;
# all three URLs must be HTTPS. Set MOCK_CONNECTORS=false and remove mock DNS mode.
# Supply a unique 32+ character BETTER_AUTH_SECRET and valid 32-byte base64url encryption keys.
# Use a real mail service, not Mailpit (localhost/mailpit hosts and port 1025 are refused).
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false  # STARTTLS is required in production; use true for implicit TLS / port 465.
# SMTP_FROM=Your service team <service@your-business.example>
# SMTP_USER=  # Optional; supply both user and password if the service requires authentication.
# SMTP_PASSWORD=  # Secret environment only, never commit a populated value.
# LOCAL_SMOKE_TEST=true allows only loopback HTTP URLs for local production startup checks.
# It does NOT allow missing settings, mock connectors/DNS, Mailpit or unsafe signing keys.
# Leave this unset in deployed environments. Build-time compilation does not require runtime config.
